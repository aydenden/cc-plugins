{
  "edit": {
    "*": "deny",
    "**/*.md": "allow",
    "**/*.mdx": "allow",
    "**/*.rst": "allow",
    "**/*.txt": "allow",
    "**/*.adoc": "allow",
    "**/README*": "allow",
    "**/CHANGELOG*": "allow",
    "**/.env*": "deny",
    "**/secrets/**": "deny"
  },
  "bash": {
    "*": "deny",
    "git status*": "allow",
    "git diff*": "allow",
    "ls *": "allow",
    "cat *": "allow"
  },
  "read": "allow",
  "grep": "allow",
  "glob": "allow",
  "webfetch": "deny",
  "websearch": "deny",
  "external_directory": "deny",
  "task": "deny",
  "question": "deny"
}
