{
  "edit": {
    "*": "allow",
    "*.env*": "deny",
    "**/secrets/**": "deny",
    "**/.git/**": "deny",
    "**/node_modules/**": "deny",
    "**/target/**": "deny"
  },
  "bash": {
    "*": "deny",
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "npm test*": "allow",
    "npm run *": "allow",
    "pnpm test*": "allow",
    "pnpm run *": "allow",
    "cargo test*": "allow",
    "cargo check*": "allow",
    "cargo build*": "allow",
    "cargo clippy*": "allow",
    "pytest*": "allow",
    "ls *": "allow",
