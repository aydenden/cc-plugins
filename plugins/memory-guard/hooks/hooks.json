{
  "description": "Guard CC auto memory: block writes that bloat MEMORY.md past its budget (PreToolUse), warn about index structure right after a memory write (PostToolUse, non-blocking), and run a once-a-day stale/broken-link/orphan check (SessionStart).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/index-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-write-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-check.mjs\"",
            "asyncRewake": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
