{
  "description": "문서를 쓴 직후 인용을 검사하고 부재 주장을 경고한다. 축이 빠졌거나 프리뷰·불변식이 통과하지 못한 문서의 티켓은 bd close 를 막는다.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-post-edit.mjs\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-pre-close.mjs\"", "timeout": 20 }
        ]
      }
    ]
  }
}
